# Docker builds use an allowlist. Runtime state and newly-created local folders
# must never become part of the build context by accident.
# Keep the named state exclusions explicit for tooling and human inspection.
data
tmp
config/*
**

# Application runtime
!main.py
!VERSION
!requirements.txt
!docker-compose.yml
!Dockerfile
!src/
!src/**
!static/
!static/**
!docker/
docker/**
!docker/*.sh
!scripts/
scripts/**
!scripts/smoke_package.py
!scripts/update.ps1
!scripts/update.sh
!scripts/update_runtime.py

# The settings endpoint serves these documents from the image.
!docs/
docs/**
!docs/API.md
!docs/VIDS_API.md
!docs/DOCKER_UPDATE.md
!docs/WINDOWS_INSTALL.md
!docs/CHANGELOG.md

# Image metadata and the sample config used by Compose mounts.
!config/
config/**
!config/setting_example.toml
!README.md
!LICENSE
!NOTICE
!SECURITY.md
!.env.example

# Re-apply state and secret exclusions after the public directory rules.
**/__pycache__
**/*.py[cod]
**/.pytest_cache
**/.ruff_cache
**/node_modules
**/*.db
**/*.db-*
**/*.sqlite*
**/*.log
**/*.json
**/*.pem
**/*.key
**/*.private*
**/*.local.*
**/*.session.json
**/*.session.enc
**/*.tar.gz
**/*.zip
**/.env
**/.env.*
!.env.example
!config/setting_example.toml
