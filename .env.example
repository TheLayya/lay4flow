# Local port for the management UI and API. Private credentials belong in config/setting.toml.
LAY4FLOW_REMOTE_PORT=38000
# Windows launcher detects the active system/PAC/Clash HTTP proxy at startup.
# auto: detect; direct: no first hop; manual: use LAY4FLOW_HOST_PROXY.
LAY4FLOW_HOST_PROXY_MODE=auto
LAY4FLOW_HOST_PROXY=
